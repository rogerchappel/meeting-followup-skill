{
  "name": "meeting-followup-skill",
  "version": "0.1.0",
  "description": "Local-first agent skill for safe meeting follow-up drafts and action registers",
  "type": "module",
  "bin": {
    "meeting-followup-skill": "./bin/meeting-followup-skill.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "smoke": "node bin/meeting-followup-skill.js plan --input fixtures/customer-sync.md --format md",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "meetings",
    "follow-up",
    "crm",
    "dry-run"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "fixtures",
    "docs",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/meeting-followup-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/meeting-followup-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/meeting-followup-skill#readme",
  "author": "Roger Chappel"
}
